# Balaji Holidays Environment Variables Configuration
# Copy this file to .env and adjust as necessary

# Django settings
SECRET_KEY=django-insecure-your-secret-key-goes-here-make-it-long-and-random
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Database configuration
# Leave empty to use default SQLite database locally.
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=

# Supabase configuration (optional, server-side only)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-never-expose-to-client

# Maps API key (optional, for map views)
MAPS_API_KEY=your-google-maps-api-key
